# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# Claude session-history buffer (local only)
.remember/

# Obsidian workspace state (vault content in wiki/ IS tracked)
wiki/.obsidian/

# typescript
*.tsbuildinfo
next-env.d.ts

# Local test images (copyrighted press material, never committed)
/public/reference/

# Prototype-only CC0 model assets (see wiki/notes/prototype-figure-rig.md)
/public/prototype/
